# Copy to .env and adjust as needed. docker-compose.yml uses sane defaults already,
# these are here for reference / for running services outside Compose.

# --- Postgres ---
POSTGRES_DB=govportal
POSTGRES_USER=govportal
POSTGRES_PASSWORD=change-me

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/gov-portal
KEYCLOAK_CLIENT_ID=gov-portal-frontend

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Frontend ---
VITE_API_PROXY_TARGET=http://localhost:8080
