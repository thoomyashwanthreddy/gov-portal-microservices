{
  "realm": "gov-portal",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "citizen", "description": "Can submit and view their own service requests" },
      { "name": "case-worker", "description": "Can view and triage all service requests" }
    ]
  },
  "clients": [
    {
      "clientId": "gov-portal-frontend",
      "name": "Gov Portal Frontend",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:5173/*", "http://localhost/*"],
      "webOrigins": ["http://localhost:5173", "http://localhost"]
    }
  ],
  "users": [
    {
      "username": "jane.citizen",
      "enabled": true,
      "email": "jane.citizen@example.com",
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "citizen123", "temporary": false }
      ],
      "realmRoles": ["citizen"]
    },
    {
      "username": "worker.bob",
      "enabled": true,
      "email": "worker.bob@example.com",
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "worker123", "temporary": false }
      ],
      "realmRoles": ["case-worker"]
    }
  ]
}
